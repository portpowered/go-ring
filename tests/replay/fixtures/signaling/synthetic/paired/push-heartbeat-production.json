{
  "provenance": "hand-authored synthetic push heartbeat exchange exercised through the production PushSubscription heartbeat method at a test-only short interval; no provider capture",
  "handshake": {
    "path": "/ws",
    "query": {
      "token": [
        "synthetic-legacy-ticket"
      ]
    }
  },
  "steps": [
    {
      "kind": "expect",
      "frame": "text",
      "template": true,
      "body": {
        "method": "push_subscribe",
        "dialog_id": "$uuid:dialog",
        "riid": "$uuid:subscribe_request",
        "body": {
          "requested_notifications": [
            {
              "filter_identifier": "synthetic-filter",
              "filters": {
                "doorbot_ids": [
                  1000
                ]
              },
              "notification_scope": "event",
              "notification_type": "shoulder_tap"
            }
          ]
        }
      },
      "channel": "pushSubscribe"
    },
    {
      "kind": "send",
      "frame": "text",
      "template": true,
      "body": {
        "method": "push_subscription_ack",
        "dialog_id": "$ref:dialog",
        "body": {
          "status": "ok",
          "subscription_id": "synthetic-subscription"
        }
      },
      "channel": "pushSubscriptionAck"
    },
    {
      "kind": "expect",
      "frame": "text",
      "template": true,
      "body": {
        "method": "push_heartbeat",
        "dialog_id": "$ref:dialog",
        "riid": "$uuid:heartbeat_request",
        "body": {
          "subscription_id": "synthetic-subscription"
        }
      },
      "channel": "pushHeartbeat"
    },
    {
      "kind": "expect",
      "frame": "text",
      "template": true,
      "body": {
        "method": "push_unsubscribe",
        "dialog_id": "$ref:dialog",
        "riid": "$uuid:unsubscribe_request",
        "body": {
          "subscription_id": "synthetic-subscription"
        }
      },
      "channel": "pushUnsubscribe"
    }
  ]
}
